{
  "name": "at-least-two-operator",
  "title": "\"At least 2\" is >= 2",
  "origin": "Scenario B — the inclusive half of the operator pair.",
  "what_it_guards": ["silently normalizing one threshold phrasing into another"],
  "initial_workspace": {
    "map": {"width_m": 12, "height_m": 10, "walls": true},
    "sources": [
      {"key": "Camera 3", "calibrated": true, "sees_aisle_04": true},
      {"key": "Camera 4", "calibrated": true, "sees_aisle_04": true}
    ],
    "zones": ["Aisle 04"],
    "multiview_group": {"key": "Warehouse floor", "sources": ["Camera 3", "Camera 4"]},
    "perception": "healthy person detection_tracking on both sources"
  },
  "turns": [
    {
      "user": "Alert me when at least 2 people are in Aisle 04.",
      "expect": {
        "actions_required": ["configure_saved_query", "configure_alert"],
        "actions_forbidden": ["commit_zone", "get_worker_recipe"]
      },
      "why": "The zone and perception exist; only the question and the threshold are new."
    }
  ],
  "order_required": [["configure_saved_query", "configure_alert"]],
  "action_arguments": [
    {"action": "configure_alert", "where": {"operator": ">=", "value": 2}}
  ],
  "expected_final_resources": {
    "alert_operator": ">=",
    "alert_value": 2,
    "fires_at_occupancy_2": true,
    "fires_at_occupancy_1": false
  },
  "reference_transcript": {
    "steps": [
      {"turn": 0, "action": "inspect_workspace", "args": {"entity_type": "person"}},
      {"turn": 0, "action": "run_query", "args": {
        "subject": "fused_entity", "measures": ["current_occupancy"],
        "filters": {"group_ids": ["$group"], "zone_ids": ["$zone"], "entity_types": ["person"]}}},
      {"turn": 0, "action": "configure_saved_query", "args": {
        "name": "People in Aisle 04", "subject": "fused_entity",
        "measures": ["current_occupancy"],
        "filters": {"group_ids": ["$group"], "zone_ids": ["$zone"], "entity_types": ["person"]}}},
      {"turn": 0, "action": "configure_alert", "args": {
        "name": "At least 2 people in Aisle 04", "query_id": "$query",
        "operator": ">=", "value": 2, "for_seconds": 0}}
    ]
  }
}
