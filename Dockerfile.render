FROM node:22-bookworm-slim AS dashboard-build
WORKDIR /build/dashboard
COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci
COPY dashboard/ ./
RUN npm run build

FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=10000 \
    STORELENS_DATA=/data \
    STORELENS_ENDPOINT_PROFILE=render \
    STORELENS_SEED_DEMO=false \
    STORELENS_PUBLIC_READS=true
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.server.txt ./
RUN pip install --no-cache-dir -r requirements.server.txt
COPY config/ ./config/
COPY server/ ./server/
COPY mcp_server/ ./mcp_server/
COPY scripts/ ./scripts/
COPY sdk/ ./sdk/
COPY skills/ ./skills/
COPY deploy/render/ ./deploy/render/
COPY AGENTS.md README.md ./
COPY --from=dashboard-build /build/dashboard/dist ./dashboard/dist
RUN mkdir -p /data \
    && chown -R 65532:65532 /app /data
USER 65532:65532
EXPOSE 10000
CMD ["python", "scripts/run_render.py"]
